###### 3.3.2 *Fermat Test* Function $fermatTest$
*The Fermat test is performed by choosing at random a number a between 1 and n - 1 inclusive and checking whether the remainder modulo n of the nth power of a is equal to a.* (SICP, 1996; 2016, p.68) 
"

# ╔═╡ e57b3eb9-a394-4253-8f23-76ff51bc1998
histogram([rand(1:10) for i in 1:1E4], bins=1:11, size=(800, 250))                

# ╔═╡ 7079c8a5-af5b-4083-b494-aaaf0ed1336a
# idiomatic Julia-code with 'rand'
function fermatTest1(p::Signed)
	#-----------------------------------------------------------------------------
	# long form as in theorem
	tryIt(a) = expmod(a, p, p) == mod(a, p)
	#-----------------------------------------------------------------------------
	p <= 1    ? false :
    p <= 3    ? true  :
    iseven(p) ? false : tryIt(rand(1:p-1))      # 1 < rand < (p-1)
	#-----------------------------------------------------------------------------
end # fermat_test1

