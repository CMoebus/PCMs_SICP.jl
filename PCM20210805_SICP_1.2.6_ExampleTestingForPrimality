# ╔═╡ b1601460-c2d3-492a-85cc-c3cd08a37546
function fastPrime3(n::Integer, ntrials::Integer)::Bool
	#-----------------------------------------------------------------------------
	while (ntrials != 0) && fermatTest2(n)
		ntrials -= 1
	end
	ntrials > 0 ? false : true
	#-----------------------------------------------------------------------------
end # function fastPrime3

