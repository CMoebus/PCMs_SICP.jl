# ╔═╡ e78e17f2-c9fa-4f5b-aefc-8c3e580f117f
function findDivisor(n, testDivisor)
	#-----------------------------------------------------------------------------
	testDivisor^2 > n ? n :                     # SICP stop condition
	isDivisor(testDivisor, n) ? testDivisor :
		iseven(testDivisor) ? 
			findDivisor(n, testDivisor + 1) :   # tail recursive call
			findDivisor(n, testDivisor + 2)     # tail recursive call
	#-----------------------------------------------------------------------------
end # function findDivisor

# ╔═╡ afcd5e13-b61a-491a-bf4f-47ea59fe112d
function smallestDivisor(n) 
	findDivisor(n, 2)
end # function smallestDivisor

