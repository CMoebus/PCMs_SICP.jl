# ╔═╡ 4eb6cc09-f864-4a80-9d8d-a03a08e0f97e
let count = 0
	for i = 1:100
		count = i
		i > 5 && break # if ... then ...
	end # for
	count
end # let

# ╔═╡ 2beafb91-5227-45eb-bb09-138128713268
# function-wide scope of 'n';  suppressed in local functions
function isPrime4(n::Signed)
	#-----------------------------------------------------------------------------
	isDivisor(a::Signed, b::Signed)::Bool = rem(b, a) == 0 
	#-----------------------------------------------------------------------------
	function smallestDivisor()::Signed
		testDivisor = 2
		for i = 2:round(Int,√n)
			testDivisor = i
			isDivisor(testDivisor, n) && break
		end # for
		isDivisor(testDivisor, n) ? testDivisor : n
	end # function smallestDivisor
	#-----------------------------------------------------------------------------
	n <= 1    ? false :
    n <= 3    ? true  :
	let smallestDivisorNumber = smallestDivisor()
		iseven(n) ? (false, smallestDivisorNumber) :      # ==> (false, factor)
		n == smallestDivisorNumber ? true :               # ==> prime
		(false, smallestDivisorNumber)                    # ==> (false, factor)
	end # let
	#-----------------------------------------------------------------------------
end # function isPrime4

