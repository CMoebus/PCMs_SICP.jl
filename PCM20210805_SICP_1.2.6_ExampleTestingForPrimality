###### 4.1 Iterative Function $isprime3$ 
with localized definitions and function-wide scope of $n$

"

# ╔═╡ 36ccf5f4-2106-4055-a255-457fe6e88185
# 'n' in local functions suppressed 
function isPrime3(n) 
	#-----------------------------------------------------------------------------
	remainder = %          # idiomatic Julia '%'
	#-----------------------------------------------------------------------------
	isDivisor(a, b)   = remainder(b, a) == 0
	#-----------------------------------------------------------------------------
	smallestDivisor() = findDivisor(n, 2)
	#-----------------------------------------------------------------------------
	function findDivisor(n, testDivisor)  
		testDivisor^2 > n ? n : 
		isDivisor(testDivisor, n) ? testDivisor : 
			findDivisor(n, testDivisor + 1)
	end # function findDivisor
	#-----------------------------------------------------------------------------
	n <= 1    ? false :
    n <= 3    ? true  :
	let smallestDivisorNumber = smallestDivisor()
		iseven(n) ? (false, smallestDivisorNumber) :      # ==> (false, factor)
		n == smallestDivisorNumber ? true :               # ==> prime
		(false, smallestDivisorNumber)                    # ==> (false, factor)
	end # let
	#-----------------------------------------------------------------------------
end # function isPrime3

