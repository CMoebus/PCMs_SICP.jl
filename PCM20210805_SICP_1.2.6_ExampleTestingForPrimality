###### 3.4.1 *Fermat Test* Function $fermatTest2$
*The Fermat test is performed by choosing at random a number a between 1 and n - 1 inclusive and checking whether the remainder modulo n of the nth power of a is equal to a.* (SICP, 1996; 2016, p.68) 
"

# ╔═╡ 88f02453-317c-4162-bb18-764715015a0b
# idiomatic Julia-code with 'rand'
function fermatTest2(n::Signed)::Bool 
	#--------------------------------------------------------------------
	tryIt(a) = (gcd(n, a) == 1) && (expmod(a, n-1, n) == 1) 
	#--------------------------------------------------------------------
	n <= 1    ? false :
    n <= 3    ? true  :
    iseven(n) ? false : tryIt(rand(1:n-1))
	#--------------------------------------------------------------------
end # fermatTest2

# ╔═╡ 640bd295-5df7-438c-bd70-b6e8dd6824da
