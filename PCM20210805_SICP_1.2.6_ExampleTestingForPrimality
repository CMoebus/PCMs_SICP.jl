###### 3.2 Variation  of $isPrime$: *Generic* (*Polymorphic*) function $isPrime2$
with *local* function definitions
"

# ╔═╡ 9979c1e4-349b-4e0a-87a0-39de45ecdf4c
function isPrime2(p)   
	#-----------------------------------------------------------------------------
	remainder = %                                         # idiomatic Julia '%'
	#-----------------------------------------------------------------------------
	isDivisor(a, b)    = remainder(b, a) == 0
	#-----------------------------------------------------------------------------
	smallestDivisor(p) = findDivisor(p, 2)
	#-----------------------------------------------------------------------------
	function findDivisor(p, testDivisor)
		testDivisor^2 > p ? p :                           # SICP stop condition
		isDivisor(testDivisor, p) ? testDivisor :
			iseven(testDivisor) ? 
				findDivisor(p, testDivisor + 1) :         # tail recursive call
				findDivisor(p, testDivisor + 2)           # tail recursive call
	end # function findDivisor
	#-----------------------------------------------------------------------------
	p <= 1    ? false :
    p <= 3    ? true  :
	let smallestDivisorNumber = smallestDivisor(p)
		iseven(p) ? (false, smallestDivisorNumber) :      # ==> (false, factor)
		p == smallestDivisorNumber ? true :               # ==> prime
		(false, smallestDivisorNumber)                    # ==> (false, factor)
	end # let
	#-----------------------------------------------------------------------------
end # function isPrime2

